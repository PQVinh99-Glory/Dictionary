# SUPABASE
SUPABASE_URL=
SUPABASE_ANON_KEY=

# CLOUDFLARE R2 binding is configured in Pages, not as text secret:
# CATALOGUE_BUCKET

# KIM FEATURE FLAGS
MORIS_ENABLED=true
MORIS_VECTOR_SEARCH_ENABLED=true
MORIS_GEMINI_RERANK_ENABLED=false
MORIS_GEMMA_JUDGE_ENABLED=false
MORIS_V4_ROLLBACK_ENABLED=true

# VECTOR PROFILE
MORIS_VECTOR_MODEL=onnx-community/dinov2-small
MORIS_VECTOR_MODEL_VERSION=ef1fb10
MORIS_PREPROCESS_VERSION=kim_canon_v2
MORIS_EMBEDDING_PROFILE=cls_l2_v1
MORIS_VECTOR_DIMENSION=384
MORIS_VECTOR_TOP_K=60
MORIS_RESOLVER_TOP_K=10
MORIS_VECTOR_MIN=0.55
MORIS_MAX_SCAN_ROWS=1500

# EXTERNAL SPECIALIZED MODEL ENDPOINTS
# One of these is required if the client does not send query_embedding.
MORIS_EMBEDDING_ENDPOINT=
MORIS_EMBEDDING_BEARER_TOKEN=

# Optional dedicated background-removal / segmentation endpoint.
MORIS_FOREGROUND_ENDPOINT=
MORIS_FOREGROUND_BEARER_TOKEN=

# GEMINI
GEMINI_API_KEY=
MORIS_GEMINI_MODEL=gemini-3.5-flash
MORIS_GEMINI_RERANK_ENABLED=false
MORIS_MAX_GEMINI_CALLS=1
MORIS_GEMINI_TIMEOUT_MS=60000

# OPENROUTER / GEMMA
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Thu Ky Moris
MORIS_GEMMA_MODEL=google/gemma-4-31b-it:free
MORIS_GEMMA_JUDGE_ENABLED=false
MORIS_MAX_OPENROUTER_CALLS=1
MORIS_OPENROUTER_TIMEOUT_MS=30000

# GATES
MORIS_AMBIGUITY_GAP=0.035
MORIS_JUDGE_GAP=0.05

# ADMIN ROUTES
MORIS_ADMIN_TOKEN=
